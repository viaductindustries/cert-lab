{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "version-file": "version.txt",
      "initial-version": "1.0.0",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features",
          "hidden": false
        },
        {
          "type": "fix",
          "section": "Bug Fixes",
          "hidden": false
        },
        {
          "type": "perf",
          "section": "Performance",
          "hidden": false
        },
        {
          "type": "refactor",
          "section": "Refactoring",
          "hidden": false
        },
        {
          "type": "docs",
          "section": "Documentation",
          "hidden": false
        },
        {
          "type": "test",
          "section": "Tests",
          "hidden": false
        },
        {
          "type": "ci",
          "section": "Continuous Integration",
          "hidden": false
        },
        {
          "type": "build",
          "section": "Build",
          "hidden": false
        },
        {
          "type": "chore",
          "section": "Maintenance",
          "hidden": false
        },
        {
          "type": "style",
          "section": "Code Style",
          "hidden": false
        },
        {
          "type": "revert",
          "section": "Reverts",
          "hidden": false
        }
      ]
    }
  }
}
